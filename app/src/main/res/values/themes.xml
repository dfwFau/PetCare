<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PetCare" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primaryColor</item>
        <item name="colorPrimaryVariant">@color/primaryDarkColor</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/secondaryColor</item>
        <item name="colorSecondaryVariant">@color/secondaryColor</item>
        <item name="colorOnSecondary">@color/primaryTextColor</item>

        <!-- Background and Surface colors -->
        <item name="android:windowBackground">@color/backgroundColor</item>
        <item name="colorSurface">@color/surfaceColor</item>
        <item name="colorOnSurface">@color/primaryTextColor</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/backgroundColor</item>
        <item name="android:windowLightStatusBar">true</item>

        <item name="bottomNavigationStyle">@style/Widget.PetCare.BottomNavigation</item>
    </style>

    <style name="Widget.PetCare.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">2dp</item>
        <item name="android:layout_margin">8dp</item>
        <item name="cardBackgroundColor">@color/surfaceColor</item>
    </style>

    <style name="Widget.PetCare.BottomNavigation" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="backgroundTint">@color/white</item>
        <item name="itemIconTint">@color/primaryColor</item>
        <item name="itemTextColor">@color/primaryColor</item>
        <item name="elevation">4dp</item>
    </style>

    <style name="ShapeAppearance.PetCare.RoundedImage" parent="">
        <item name="cornerSize">20dp</item>
    </style>
</resources>